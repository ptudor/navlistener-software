# navfeeder-esp test build for the MAX mobile observer alone: MAX-M10S receiver,
# MCP79412 RTC, motion sensors and the thermocouple input. It still runs only what the
# manifest lists. Loaded after sdkconfig.defaults and sdkconfig.defaults.s3; see
# build-navfeeder-esp.sh.
CONFIG_NVF_BOARD_GNSS_COLOR_MAX=y
