menu "navfeeder-esp"

    config NVF_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            STA network to join. Leave empty to run receiver-only (bench throughput log, no
            network). Production units are provisioned into NVS (P5), not built-in here.

    config NVF_WIFI_PASS
        string "WiFi password"
        default ""

    config NVF_SETUP_CONSOLE_PASSWORD
        bool "Show the setup password on every development setup boot"
        depends on !SECURE_BOOT
        default y
        help
            Reprint the persistent BLE/SoftAP setup label on the USB/serial
            console whenever setup starts, including after a configuration
            reset. This does not print the joined WiFi network's password.
            Disable for production: unfused manufacturing then prints only
            newly created labels. Secure Boot builds never print setup secrets.

    config NVF_COLLECTOR_HOST
        string "Collector host"
        default ""
        help
            The navlistener collector's [push] endpoint hostname. Empty => no pusher.

    config NVF_COLLECTOR_PORT
        int "Collector push port"
        default 5580

    config NVF_TOKEN
        string "Bearer token"
        default ""
        help
            One-time enrollment token granting the 'ubx' feed. Dev only here; production
            tokens live in NVS, never in a committed sdkconfig.

    config NVF_STATION
        string "Station id"
        default "navfeeder-esp-1"

    config NVF_INSECURE
        bool "Skip TLS verification (dev only)"
        default n
        select ESP_TLS_INSECURE
        select ESP_TLS_SKIP_SERVER_CERT_VERIFY
        help
            Do not verify the collector's certificate. Dev bench only — a production unit
            pins the collector CA (embed it or provision it).

            this also selects esp-tls's own ESP_TLS_INSECURE/
            ESP_TLS_SKIP_SERVER_CERT_VERIFY Kconfig options. Without them, connect_collector()'s
            insecure branch (leaving both cacert_buf and crt_bundle_attach unset) makes esp-tls
            hard-fail the connection outright ("no server verification option set") rather than
            skip verification — the insecure path silently never worked. Enabling this Kconfig
            makes esp-tls skip verification specifically for connections (like ours) that leave
            every verification option unset, instead of failing them.

    config NVF_ALLOW_INSECURE_PORTAL
        bool "Allow the provisioning portal to set insecure=1 (dev/bench only)"
        default n
        help
            the SoftAP provisioning portal is reachable by anyone in radio range
            during setup. With this off (the shipped default), the portal has no control
            to disable TLS verification on a running unit — 'insecure' is bench/compile-time
            only (NVF_INSECURE above, or a direct NVS write on the bench). Turn this on only
            for a dev/bench build where a field-settable TLS downgrade is acceptable.

    config NVF_CONFIG_RESET_GPIO
        int "Runtime configuration-reset button GPIO (-1 disables)"
        range -1 48
        default 0 if IDF_TARGET_ESP32S3
        default -1
        help
            Active-low button sampled only after the application boots. Hold for eight
            seconds and release to erase the navfeeder configuration namespace and reopen
            the provisioning portal. The custom ESP32-S3 observer uses its BOOT/DOWNLOAD
            button on GPIO0.

            Keep this disabled on the Waveshare ESP32-C6-LCD-1.47 build: that board's BOOT
            button is GPIO9, which this firmware also uses as the receiver's UART RX. A
            runtime press would electrically contend with the receiver's push-pull TX.

    config NVF_BOARD_GNSS_COLOR
        bool "Custom GNSS color observer (ESP32-S3)"
        depends on IDF_TARGET_ESP32S3
        default y
        help
            Select a project ESP32-S3 observer PCB, then the board below. Every
            board uses the GPIO6/GPIO7 hardware-manifest bus and GPIO4/GPIO5 for
            receiver UART TX/RX, and suppresses the Waveshare C6 LCD/WS2812
            drivers whose fixed pins conflict with it.

    choice NVF_BOARD_ASSEMBLY
        prompt "Observer board"
        depends on NVF_BOARD_GNSS_COLOR
        default NVF_BOARD_GNSS_COLOR_NEO
        help
            The board this image drives. Its pins, drivers and the board ID in
            the OTA image metadata follow this choice, so an image installs
            only on its own board. main/board_reservations.h is the pin record.

        config NVF_BOARD_GNSS_COLOR_NEO
            bool "NEO (NEO-M9N; BOOT steps the panel brightness)"
        config NVF_BOARD_GNSS_COLOR_ZED_X20
            bool "ZED/X20 (ZED-X20P, MAX31328 RTC, W5500 Ethernet, optional front panel)"
        config NVF_BOARD_GNSS_COLOR_MAX
            bool "MAX (MAX-M10S mobile, motion sensors, thermocouple input)"
    endchoice

    config NVF_ETHERNET_W5500
        bool
        default y if NVF_BOARD_GNSS_COLOR_ZED_X20
        select ETH_SPI_ETHERNET_W5500
        help
            The board's own W5500 Ethernet port: a wired uplink preferred over
            Wi-Fi, which makes the Wi-Fi network optional in provisioning.

    config NVF_PANEL_TRIMMER_OPEN_MV
        int "Brightness trimmer open-wiper threshold, mV"
        depends on NVF_BOARD_GNSS_COLOR_ZED_X20 || NVF_BOARD_GNSS_COLOR_MAX
        range 2900 3200
        default 3000
        help
            The wiper's valid range ends at about 2.86 V worst case (R50 and VR1
            tolerance); R48 pulls an open wiper to 3V3. A calibrated reading at or
            above this is an open or faulty trimmer, and brightness stays at the
            saved or default setting. Confirm the margin on the assembled board.

    choice NVF_ENV_HDC_VARIANT
        prompt "Fitted humidity sensor at 0x40"
        depends on NVF_BOARD_GNSS_COLOR
        default NVF_ENV_HDC2080
        help
            Select the assembled part. HDC2080 and HDC2022 share manufacturer
            and device IDs, so probing cannot select the temperature formula.
            This selection is a build setting, not inferred from the EEPROM.

        config NVF_ENV_HDC2080
            bool "HDC2080 (Rev C, nominal 3.3 V correction)"

        config NVF_ENV_HDC2022
            bool "HDC2022 (Rev A)"
    endchoice

    menu "HDC humidity-sensor heater (condensation recovery)"
        depends on NVF_BOARD_GNSS_COLOR

        comment "Engineering defaults, not yet derived from fleet data"

        config NVF_ENV_HEATER_TRIGGER_RH_TENTHS
            int "Condensing humidity, 0.1 %RH"
            range 800 1000
            default 980
            help
                TI SNAS678C section 8.3.3 reserves the HDC heater for a detected
                condensing condition. A run needs every valid HDC sample at or above
                this humidity for the whole trigger duration below.

        config NVF_ENV_HEATER_TRIGGER_MINUTES
            int "Continuous condensing duration, minutes"
            range 30 1440
            default 240
            help
                Invalid samples do not count toward this duration. Any valid sample
                below the condensing humidity restarts it.

        config NVF_ENV_HEATER_GAP_MINUTES
            int "Longest gap without a valid HDC sample, minutes"
            range 1 120
            default 30
            help
                A longer gap between valid samples restarts the condensing count.

        config NVF_ENV_HEATER_MIN_TENTHS_C
            int "Lowest HDC temperature for a run, 0.1 C"
            range -200 700
            default -200
            help
                The HDC humidity element is specified from -20 to 70 C.

        config NVF_ENV_HEATER_MAX_TENTHS_C
            int "Highest HDC temperature for a run, 0.1 C"
            range -200 700
            default 600
            help
                Above this, the 90 mA heater load could take the 3V3_SENS
                regulator past its junction limit. The humidity element itself
                is specified to 70 C.

        config NVF_ENV_HEATER_INTERVAL_DAYS
            int "Minimum interval between automatic runs, days"
            range 1 365
            default 14
            help
                Measured with trusted UTC only (GNSS-qualified, or the validated
                running RTC). The start time of each run is saved in NVS before the
                heater is enabled. Without trusted UTC, no automatic run starts.

        config NVF_ENV_HEATER_STEP_SECONDS
            int "Conversion interval while heating, seconds"
            range 1 60
            default 10
            help
                A manual HDC and MCP9808 conversion, and a HEAT_EN read-back, at
                this interval while the heater is on. A failed heater-off is also
                retried at this interval.

        config NVF_ENV_HEATER_DRY_RH_TENTHS
            int "Dry stop humidity, 0.1 %RH"
            range 0 300
            default 50
            help
                TI SNAS678C section 8.3.3: turn the heater off once humidity reads
                at or near 0 %RH.

        config NVF_ENV_HEATER_MAX_ON_SECONDS
            int "Maximum heater on-time, seconds"
            range 30 600
            default 300

        config NVF_ENV_HEATER_OVERTEMP_TENTHS_C
            int "Over-temperature stop, 0.1 C"
            range 300 840
            default 800
            help
                With the heater on, the HDC must stay below 85 C (THEATER, TI
                SNAS678C). The heater stops when a conversion reads this or more.

        config NVF_ENV_HEATER_SETTLE_MINUTES
            int "Minimum cool-down before HDC readings count, minutes"
            range 1 60
            default 10

        config NVF_ENV_HEATER_STABLE_MINUTES
            int "Cool-down stability window, minutes"
            range 1 30
            default 5
            help
                After the minimum cool-down, HDC readings count again once the HDC
                temperature has changed less than the stability limit over this
                window.

        config NVF_ENV_HEATER_STABLE_TENTHS_C
            int "Cool-down stability limit, 0.1 C"
            range 1 20
            default 2

        config NVF_ENV_HEATER_RECOVERY_MAX_MINUTES
            int "Longest cool-down, minutes"
            range 10 240
            default 60
            help
                Normal HDC service resumes after this long even if the stability
                test has not passed.
    endmenu

    config NVF_MANIFEST_FACTORY_INIT
        bool "Initialize a never-seen blank manifest from board defaults"
        depends on NVF_BOARD_GNSS_COLOR && NVF_ENV_HDC2080
        default n
        help
            Manufacturing-only permission. If the manifest EEPROM reads as
            blank, its 128-bit factory serial (24CS or M24128-U) is valid, and
            that identity has never been recorded
            in the independent hwmanifest NVS namespace, program the compiled
            GNSS_PCB_MAIN revision-A component list chosen below and verify it
            by readback. Every list specifies HDC2080, so this option is
            unavailable for HDC2022 assemblies; their manifest must be
            provisioned separately.

            Leave this off in ordinary firmware. I2C errors, malformed records,
            a blank previously-known EEPROM, and a different/replacement
            identity are always refused regardless of this option.

    choice NVF_MANIFEST_BOARD
        prompt "Board assembly for the factory-initialized manifest"
        depends on NVF_MANIFEST_FACTORY_INIT
        default NVF_MANIFEST_BOARD_ZED_X20_A if NVF_BOARD_GNSS_COLOR_ZED_X20
        default NVF_MANIFEST_BOARD_MAX_A if NVF_BOARD_GNSS_COLOR_MAX
        default NVF_MANIFEST_BOARD_NEO_A
        help
            The compiled component list factory initialization writes: the
            receiver, RTC, sensors, gated regulators and connectors of one
            revision of this build's board.

        config NVF_MANIFEST_BOARD_NEO_A
            bool "NEO-M9N first spin, revision A"
            depends on NVF_BOARD_GNSS_COLOR_NEO
        config NVF_MANIFEST_BOARD_MAX_A
            bool "MAX-M10S mobile, revision A"
            depends on NVF_BOARD_GNSS_COLOR_MAX
        config NVF_MANIFEST_BOARD_ZED_X20_A
            bool "ZED-X20P square, revision A"
            depends on NVF_BOARD_GNSS_COLOR_ZED_X20
    endchoice

    config NVF_OTA
        bool "On-demand authenticated HTTPS OTA"
        depends on NVF_BOARD_GNSS_COLOR
        default y
        select BOOTLOADER_APP_ROLLBACK_ENABLE
        select MBEDTLS_HAVE_TIME_DATE
        help
            Pair a separate update key through the password-protected provisioning
            AP, then initiate HTTPS image downloads from tools/ota.py. Requires
            the S3 OTA partition layout and an initial serial flash of the
            rollback-capable bootloader and application. No eFuses are changed.

    config NVF_WIREGUARD
        bool "WireGuard tunnel to the collector (ESP32-S3)"
        depends on NVF_BOARD_GNSS_COLOR
        default y
        help
            Accept an optional WireGuard profile at provisioning (a pasted wg-quick
            .conf in the browser portal, or the Station app's nav-tunnel endpoint)
            and carry the GNF1/TLS session inside that tunnel whenever its peer is
            up, falling back to the public collector endpoint otherwise. Only the
            collector's tunnel address is routed through it; SNTP, OTA and DNS keep
            the ordinary uplink. IPv4 only; the first handshake waits for time sync.
            The ESP32-C6 build has no tunnel support and always uses the public
            endpoint.

    choice NVF_UPDATE_PROFILE
        prompt "Signed update trust profile"
        depends on NVF_OTA
        default NVF_UPDATE_PROFILE_TRUSTED
        help
            Each build follows exactly one update track. The public TUF root
            supplied with -D NVF_TUF_ROOT_FILE=... must carry the same profile
            marker, and every release manifest repeats it, so trusted, open
            and test roots cannot be interchanged. No key is supplied by default.

        config NVF_UPDATE_PROFILE_TRUSTED
            bool "Trusted (locked hardware, production security baseline)"
            help
                The repository updater runs only with Secure Boot, release flash
                encryption and encrypted update state active. On an unfused
                development board this build stays service-only.

        config NVF_UPDATE_PROFILE_OPEN
            bool "Open (unlocked hardware, open release track)"
            depends on !SECURE_BOOT
            help
                Follows the separately rooted open release track on a board that
                is never locked. Signed metadata still protects the network
                path; it cannot protect against someone holding the board, who
                can already reflash it over USB. Refuses to run on a chip with
                Secure Boot or flash encryption enabled.

        config NVF_UPDATE_TEST_KEYS
            bool "Test (explicitly supplied throwaway trust, bench only)"
            depends on !SECURE_BOOT
            help
                Enables the signed update workflow on an unfused bench board
                against a test-only public TUF root. Release tooling for the
                trusted and open tracks rejects this setting.
    endchoice

    config NVF_COMMISSION_CONSOLE
        bool "Bench commissioning commands on the USB console"
        depends on NVF_BOARD_GNSS_COLOR
        default y
        help
            Accept `commission ...` lines on the USB Serial/JTAG console: report this
            board's identifiers, generate the microcontroller key, and install or restore
            the commissioning record (docs/COMMISSIONING.md). The commands exist only on
            the USB console; no network service reaches them. A locked unit cannot be
            reflashed over USB, so the release firmware itself carries them.

    config NVF_MCU_KEY_UNLOCKED_TEST
        bool "Allow microcontroller key generation on an unlocked test board"
        depends on NVF_UPDATE_TEST_KEYS
        default n
        help
            A microcontroller key is normally generated only once Secure Boot and
            release-mode flash encryption are active. This lets a test-profile bench board
            exercise the key, the session proof and a test commissioning record without
            locking. It still burns one eFuse key block PERMANENTLY on that module, and the
            key proves nothing about what firmware runs there.

    config NVF_RX_AUTOPROBE
        bool "Probe receiver baud and query MON-VER"
        default y if NVF_BOARD_GNSS_COLOR
        default n
        help
            Probe the configured rate, 38400, 115200, 9600, 230400 and 460800.
            A checksum-valid UBX or NMEA message establishes communication.
            This does not identify a receiver model from the board manifest.

    config NVF_RX_CONFIGURE_M9
        bool "Configure a detected NEO-M9N in receiver RAM"
        depends on NVF_RX_AUTOPROBE
        default y if NVF_BOARD_GNSS_COLOR_NEO
        help
            After MON-VER identifies NEO-M9N, select the configured baud and
            request SFRBX, MON-RF, NAV-SAT and NAV-PVT via CFG-VALSET. Check ACK/NAK for
            each setting. Do not write receiver flash or battery-backed config.

    config NVF_RX_BAUD
        int "Receiver UART baud"
        default 460800

    config NVF_SPOOL_FRAMES
        int "Spool ring capacity (frames)"
        default 1024
        range 1 65536
        help
            Bounded RAM ring of unacked records, sized against the C6 SRAM budget with
            WiFi+TLS up. This is the WHOLE outage buffer: there is no flash tier, so
            overflow drops the oldest record and any reboot discards every unacked one
            (regression fix — see README.md "Durability envelope"). At the default, roughly 100 s
            of a multi-GNSS receiver's output. Raising it buys outage depth only while the
            unit stays powered, and costs heap that WiFi/TLS also needs.

    config NVF_SPOOL_BYTES
        int "Internal RAM spool payload budget (bytes)"
        range 4096 131072
        default 65536

    config NVF_SPOOL_PSRAM
        bool "Prefer a bounded PSRAM spool"
        depends on SPIRAM
        default y if NVF_BOARD_GNSS_COLOR
        help
            Allocate metadata and payload storage explicitly in PSRAM. If either
            allocation fails, use the internal RAM frame/byte budgets instead.
            All records are lost on reboot, including a successful OTA update.

    config NVF_SPOOL_PSRAM_FRAMES
        int "PSRAM spool record limit"
        depends on NVF_SPOOL_PSRAM
        range 1024 131072
        default 65536

    config NVF_SPOOL_PSRAM_BYTES
        int "PSRAM spool payload budget (bytes)"
        depends on NVF_SPOOL_PSRAM
        range 65536 6291456
        default 4194304

endmenu
