# navfeeder-esp test build for the ZED/X20 square observer alone: ZED-X20P receiver,
# MAX31328 RTC, W5500 Ethernet and the optional front panel. It still runs only what the
# manifest lists. Loaded after sdkconfig.defaults and sdkconfig.defaults.s3; see
# build-navfeeder-esp.sh.
CONFIG_NVF_BOARD_GNSS_COLOR_ZED_X20=y
