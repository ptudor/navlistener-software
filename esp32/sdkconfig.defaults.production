# Apply only for production release builds. Do not flash this bootloader onto
# an unlocked board: first boot can irreversibly change chip security eFuses.
# Signing happens outside the build; no private-key path belongs in sdkconfig.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_SECURE_BOOT_V2_AGGRESSIVE_KEY_REVOKE=n
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=y
CONFIG_SECURE_BOOT_ALLOW_JTAG=n
CONFIG_SECURE_BOOT_ALLOW_ROM_BASIC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_DEC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_CACHE=n
CONFIG_EFUSE_VIRTUAL=n
CONFIG_NVF_UPDATE_TEST_KEYS=n
CONFIG_NVF_SETUP_CONSOLE_PASSWORD=n
CONFIG_NVF_MANIFEST_FACTORY_INIT=n
CONFIG_NVF_INSECURE=n
CONFIG_APP_REPRODUCIBLE_BUILD=y
