# navlistener configuration — example.
#
# Copy to /usr/local/etc/navlistener/navlistener.toml and edit. Configuration is
# TOML only (never a .env file). This file holds no secrets; when the persist and
# push stages land, real credentials (DB DSN, TLS keys) go only in the deployed,
# git-ignored file with 0600 permissions — never in this committed example.
#
# The pipeline is INGEST (dial + authenticated push) → DECODE → PROPAGATE +
# INTEGRITY → PERSIST → SERVE. Point [[ingest]] sources at receivers we control on
# the LAN; enroll fleet feeders under [[push.observer]]; all decoding, orbit math,
# and integrity detection is central.

[logging]
level  = "info"   # debug | info | warn | error
format = "json"   # json | text

[metrics]
# Prometheus /metrics + /healthz + /debug/state, loopback only. a reverse proxy
# terminates TLS in front; this listener never faces the network directly.
addr = "127.0.0.1:9100"

[state]
shards             = 16     # sharded per-SV live store; >= 1
sv_ttl             = "2h"   # expire an SV unseen by every receiver this long
propagate_interval = "1s"   # cadence for re-propagating live SVs to "now"
# leap_seconds overrides the compiled-in ΔtLS (GPS-UTC) default. Leave unset (0)
# unless a real leap second has been announced and a rebuild can't happen first;
# must be in 10..30 if set. Applies to served leap_seconds and every GPS/BDT
# time-of-week conversion.
# leap_seconds = 18

# TimescaleDB raw-nav-frame historian (docs/OUTPUT.md §4). Optional: leave dsn empty
# to run persist-less (dev). When set, TimescaleDB is required (a missing extension
# is fatal). The real DSN goes only in the deployed, git-ignored config, 0600.
[store]
# dsn            = "postgres://navlistener:PASSWORD@localhost/navlistener"
batch_size     = 1000    # rows per CopyFrom
batch_interval = "1s"    # flush cadence
compress_after = "1 day" # columnar-compress raw chunks older than this
raw_retention  = "7 days" # drop raw frames older than this (long-term lives in aggregates)

# Native v2 read API (docs/OUTPUT.md): /gnss/api/v2/{svs,global,observers,almanac,
# sbas} + the /gnss/events SSE stream, served from RAM. Optional: leave addr empty to
# run collector-only. Loopback only; a reverse proxy terminates TLS and fronts it as
# intsat.space. Satellites move slowly, so the refresh cadences are deliberately slow.
[serve]
# addr                    = "127.0.0.1:8080"
refresh_interval        = "30s"  # svs/global/observers/sbas
almanac_refresh_interval = "90s" # almanac (longer-life, all-SV view)
snapshot_interval        = "5m"  # persist each feed to the historian for replay/backfill; "0s" disables (needs [store].dsn)

# Authenticated GNF1 fleet push endpoint (docs/DESIGN.md §1/§2): the production
# ingest path where navfeeder edge feeders connect out to us over TLS. Optional:
# leave addr empty to accept dial-mode ingest only. When enabled, TLS is mandatory;
# the real cert/key go only in the deployed, git-ignored config, 0600.
[push]
# addr      = "0.0.0.0:5580"
# tls_cert  = "/usr/local/etc/navlistener/push.crt"
# tls_key   = "/usr/local/etc/navlistener/push.key"
# client_ca = "/usr/local/etc/navlistener/fleet-ca.crt"  # set to require mTLS (cert tiers)
ack_interval = "1s"

# One [[push.observer]] per enrolled feeder. token_sha256 is the hex SHA-256 of the
# bearer token shown once at enrollment (generate it: printf %s "$TOKEN" | sha256).
# The token itself is NEVER stored here. feeds is the grant (Device.feed_types).
# [[push.observer]]
# station      = "observer16"
# token_sha256 = "….64 hex chars.…"
# feeds        = ["ubx"]

# One [[ingest]] block per receiver we dial. type ∈ { ubx, sbf, rtcm, ntrip }.
# Leave disabled = true to keep an entry without starting it.

# [[ingest]]
# name = "observer16"           # our reference u-blox F9 box
# type = "ubx"                # UBX-RXM-SFRBX raw nav words
# addr = "192.0.2.16:2947"    # host:port to dial on the LAN
# capabilities = ["0:0", "2:0", "2:3", "3:0", "6:0"]  # declared tudorgps fingerprint: the
#                             # "gnss:sig" signals this silicon can produce (GPS L1, Galileo
#                             # I/NAV + F/NAV, BeiDou D1, GLONASS). The integrity layer flags a
#                             # declared signal that goes silent, or an observed one not listed
#                             # here (docs/INTEGRITY.md §6). Omit if unknown.

# [[ingest]]
# name = "mosaic-x5"          # a Septentrio receiver
# type = "sbf"                # SBF raw-nav blocks
# capture_only = true         # framing/CRC/raw persistence only; no live-state decode yet
# addr = "192.0.2.20:28784"

# [[ingest]]
# name = "ntrip-caster"       # an RTCM3 source (ephemeris + SSR)
# type = "rtcm"
# capture_only = true         # framing/CRC/raw persistence only; no live-state decode yet
# addr = "192.0.2.30:2101"

# NTRIP caster (RTCM3 over authenticated TLS by default), e.g. CRTN at Scripps/UCSD. Fill addr/mountpoint/username/
# password in the deployed, git-ignored config — never commit real credentials here. This build
# frames + CRC-checks + persists the RTCM3 stream (a live capture/validation source); decoding
# the RTCM ephemeris messages (1019/1020/1041/…) into live SV state is a follow-on.
#   NOTE: CRTN stations are in California, so they carry GPS/GLONASS/Galileo/BeiDou/QZSS — NOT
#   NavIC (its satellites are below the horizon here); a NavIC/1041 stream must be sourced in Asia.
# [[ingest]]
# name = "crtn-ucsd"
# type = "ntrip"
# capture_only = true         # framing/CRC/raw persistence only; no live-state decode yet
# addr = "<caster-host>:2101"  # NTRIP caster host:port
# mountpoint = "<MOUNT>"       # the mountpoint to subscribe
# username = "<user>"          # NTRIP basic-auth credentials
# password = "<pass>"
# ca_file = "/usr/local/etc/ssl/private-caster-ca.pem" # optional private CA; system roots otherwise
# server_name = "caster.example" # optional TLS name override; addr host otherwise
# Legacy plaintext requires allow_insecure_plaintext = true. Plaintext credentials additionally
# require allow_plaintext_credentials = true and set a persistent degraded-security metric.
